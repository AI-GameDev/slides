    "export": "slidev export presentations/comfyui/slides.md",
    "new": "node scripts/create-presentation.js"
  },
  "dependencies": {
    "@slidev/cli": "^52.14.2",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "slidev-addon-excalidraw": "^1.1.0",
    "slidev-theme-light-icons": "^1.0.2",
    "slidev-theme-mokkapps": "^1.3.2",
    "slidev-theme-penguin": "^2.3.1",
    "slidev-theme-tahta": "^0.13.3",
    "vue": "^3.5.32"
  }
}
